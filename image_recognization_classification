        "plt.imshow(color_img_rgb)\n",
        "plt.axis('off')\n",
        "\n",
        "plt.subplot(1,2,2)\n",
        "plt.title(\"Grayscale Image\")\n",
        "plt.imshow(gray_img, cmap='gray')\n",

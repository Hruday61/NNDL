        "# Read color image\n",
        "color_img = cv2.imread(image_path)\n",
        "\n",
        "# Convert BGR to RGB for display\n",
        "color_img_rgb = cv2.cvtColor(color_img, cv2.COLOR_BGR2RGB)\n",
